# Ask Kenya B. — the assistant on the public site.
#
# NEVER commit a real key. Copy this file to .env.local for local work (it is
# git-ignored), and set the real values in Netlify under
# Site settings → Environment variables.
#
# With no key set the assistant still runs: it answers every question by
# handing it to Kenya rather than guessing, which is the correct prototype
# behaviour.

OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=
